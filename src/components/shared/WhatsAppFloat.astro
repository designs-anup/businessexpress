---
interface Props {
  whatsappNumber: string;
  businessName: string;
}

const { whatsappNumber, businessName } = Astro.props;
const message = encodeURIComponent(`Hi ${businessName}, I found your website on Business Express and would like to inquire.`);
const waLink = `https://wa.me/${whatsappNumber}?text=${message}`;
---

<a
  href={waLink}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chat on WhatsApp"
  class="fixed bottom-5 right-5 z-50 flex items-center gap-2 rounded-full bg-[#25D366] px-4 py-3 text-sm font-semibold text-white shadow-lg transition hover:scale-105 hover:bg-[#20bd5a]"
>
  <span>WhatsApp Us</span>
</a>