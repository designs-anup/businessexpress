---
import type { SiteContent } from '../../types/site';
import WhatsAppFloat from '../shared/WhatsAppFloat.astro';

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
const waLink = `https://wa.me/${content.whatsappNumber}?text=${encodeURIComponent(
  `Hi ${content.businessName}, I would like to know more about your services.`
)}`;
---

<div class="min-h-screen flex flex-col">
  <!-- Navbar -->
  <header class="sticky top-0 z-40 border-b border-slate-200 bg-white/95 backdrop-blur">
    <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-4">
      <div class="flex items-center gap-3">
        {content.logoUrl && (
          <img src={content.logoUrl} alt={content.businessName} class="h-9 w-9 rounded object-cover" />
        )}
        <span class="text-lg font-bold tracking-tight text-slate-900">{content.businessName}</span>
      </div>
      <a
        href={`tel:${content.phone}`}
        style={`background-color: ${content.themeColor};`}
        class="rounded-lg px-4 py-2 text-sm font-medium text-white shadow-sm transition hover:opacity-90"
      >
        Call Now
      </a>
    </div>
  </header>

  <!-- Hero Section -->
  <section class="bg-white py-16 px-4 border-b border-slate-100">
    <div class="mx-auto max-w-4xl text-center">
      <span
        style={`color: ${content.themeColor}; background-color: ${content.themeColor}15;`}
        class="inline-block rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-wide"
      >
        {content.city}
      </span>
      <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">
        {content.businessName}
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-600">
        {content.tagline}
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a
          href={waLink}
          target="_blank"
          rel="noopener noreferrer"
          style={`background-color: ${content.themeColor};`}
          class="rounded-lg px-6 py-3 text-base font-semibold text-white shadow transition hover:opacity-90"
        >
          Chat on WhatsApp
        </a>
        <a
          href="#services"
          class="rounded-lg border border-slate-300 bg-white px-6 py-3 text-base font-semibold text-slate-700 transition hover:bg-slate-50"
        >
          View Services
        </a>
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section class="mx-auto max-w-4xl px-4 py-12 text-center">
    <h2 class="text-2xl font-bold text-slate-900">About Us</h2>
    <p class="mt-3 text-base leading-relaxed text-slate-600">{content.about}</p>
  </section>

  <!-- Services Grid -->
  <section id="services" class="mx-auto w-full max-w-5xl px-4 py-10">
    <h2 class="text-center text-2xl font-bold text-slate-900">Our Services</h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {content.services.map((service) => (
        <div class="flex flex-col justify-between rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
          <div>
            <h3 class="text-lg font-semibold text-slate-900">{service.title}</h3>
            <p class="mt-2 text-sm text-slate-600">{service.description}</p>
          </div>
          {service.price && (
            <p style={`color: ${content.themeColor};`} class="mt-4 text-sm font-bold">
              {service.price}
            </p>
          )}
        </div>
      ))}
    </div>
  </section>

  <!-- Contact & Address -->
  <section class="mt-auto border-t border-slate-200 bg-white py-12 px-4">
    <div class="mx-auto max-w-4xl text-center">
      <h2 class="text-2xl font-bold text-slate-900">Visit or Contact Us</h2>
      <p class="mt-3 text-slate-600">{content.address}, {content.city}</p>
      <p class="mt-1 font-medium text-slate-800">Phone: {content.phone}</p>
      {content.googleMapsUrl && (
        <a
          href={content.googleMapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          style={`color: ${content.themeColor};`}
          class="mt-3 inline-block text-sm font-semibold underline"
        >
          Open in Google Maps &rarr;
        </a>
      )}
    </div>
  </section>

  <!-- Viral Growth Footer -->
  <footer class="bg-slate-900 py-6 px-4 text-center text-xs text-slate-400">
    <p>&copy; {new Date().getFullYear()} {content.businessName}. All rights reserved.</p>
    <p class="mt-2">
      Powered by <a href="/" class="font-semibold text-white underline">Business Express</a> — Create your free business page in 3 minutes.
    </p>
  </footer>

  <WhatsAppFloat whatsappNumber={content.whatsappNumber} businessName={content.businessName} />
</div>